 tests/host/stats_layout_dump.c       | 11 ++++
 tools/dde_emu/test_logger_emulate.py | 78 +++++++++++++++++++++----
 tools/ts_capture/fr_ts_logger.py     | 58 +++++++++++++++++--
 tools/ts_capture/frts.py             | 86 +++++++++++++++++++++++++---
 5 files changed, 221 insertions(+), 26 deletions(-)
