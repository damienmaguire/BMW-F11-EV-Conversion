From 854bbe314321dfe5f89aca292a03baaaf0c411e8 Mon Sep 17 00:00:00 2001
From: "Sam (local build)" <sam@local>
Date: Fri, 30 Oct 2026 15:30:54 +0000
Subject: [PATCH 1/4] dde-emu: table generator and bit-level model from run 5
 capture

gen_dde_tables.py extracts the DDE static frames 0x26/0x28/0x29/0x3D and
dynamic 0x5C from the ign-on/engine-off capture per (slot, cycle mod 64),
the slot offsets relative to car reference frames, and the E2E groups;
writes src/dde_emu_tables.h. dde_emu_model.py: header/frame CRC, E2E
CRC8, wire encoder, PIO word packing and a PIO simulator used by tests.
---
 src/dde_emu_tables.h            | 332 +++++++++++++++++++++++++++++++
 tools/dde_emu/dde_emu_model.py  | 337 ++++++++++++++++++++++++++++++++
 tools/dde_emu/gen_dde_tables.py | 275 ++++++++++++++++++++++++++
 3 files changed, 944 insertions(+)
 create mode 100644 src/dde_emu_tables.h
 create mode 100644 tools/dde_emu/dde_emu_model.py
 create mode 100644 tools/dde_emu/gen_dde_tables.py

diff --git a/src/dde_emu_tables.h b/src/dde_emu_tables.h
new file mode 100644
index 0000000..d396995
--- /dev/null
+++ b/src/dde_emu_tables.h
@@ -0,0 +1,332 @@
