+        if (!t_rpm0 && ts && o->rpm4 == 0) t_rpm0 = T;
+        if (!t_80 && t_92 && o->e6_b3 == 0x80) t_80 = T;
+        if (t_80 && !t_ready1 && o->e6_ready == 1) t_ready1 = T;
+        if (k % 40 == 0) check_frames("stopping");
+    }
