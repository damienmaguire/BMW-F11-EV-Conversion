+fi
+if [ -f "$RUN4_NODDECAN" ]; then
+    python3 $CHK /tmp/pico_flexray_test_pte noddecan "$RUN4_NODDECAN" > /tmp/pico_flexray_pte_noddecan.txt ||
+        { cat /tmp/pico_flexray_pte_noddecan.txt; exit 1; }
