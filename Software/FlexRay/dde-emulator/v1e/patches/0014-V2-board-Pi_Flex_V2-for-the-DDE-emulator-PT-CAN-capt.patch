 src/mcp251863.h             | 100 ++++++++++
 src/mcp251863_bittiming.c   |  84 ++++++++
 src/pico_can_record.h       |  78 ++++++++
 src/v2_cantest.c            | 345 ++++++++++++++++++++++++++++++++
 src/v2_cantest.h            |  23 +++
 tests/host/run.sh           |   3 +-
 12 files changed, 1202 insertions(+), 4 deletions(-)
 create mode 100644 src/board_pico_flexray_v2.h
