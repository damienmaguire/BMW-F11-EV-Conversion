     uint8_t abs_stop_walk; // 1 = 0x397 stop walk finished (normal model again)
     uint8_t inj;           // v1h: 1 = "injecting": PT-CAN 0x3FB d4 bit0 = 0 (gateway copies it to FR 0xE9 b5)
     uint8_t e8_crank;      // v1h: 1 = 0xE8 L9 ~5.7/s (crank rate, before e8_fast)
+    // v1h.1 gear (dde_gear.c fills these). g_set 0 = fixed P: the v1h content, nothing patched.
+    // Patched even when the engine story is not active (the gear can only leave P while running).
+    uint8_t g_set;         // 1 = put the gear bytes below in
+    uint8_t g_3fd;         // PT-CAN 0x3FD d2 gear display (20 P, 40 R, 60 N, 80 D)
+    uint8_t g_39a_d3, g_39a_d4;   // PT-CAN 0x39A d3 gear (3 P, 2 R, 5 D, 1 P coming), d4 P lock (e2 / e1 / e0)
+    uint8_t g_park;        // 0x3F9 d3 / 0xE6 b4 bits 4-5 (2 P lock, 1 released, 0 in gear)
+    uint8_t g_nib;         // 0x3F9 d6 / 0xE6 b7 low nibble (3 P, 2 R, 5 D, 1 P coming)
+    uint8_t g_dc_b2, g_dc_b5;     // PT-CAN 0xDC d2/d5 = FR 0x28 c3 b11/b14 (22/fe P, 25/f4 R, 24/f4 D)
 } eng_out_t;
 
 typedef struct {
diff --git a/src/dde_gear.c b/src/dde_gear.c
new file mode 100644
index 0000000..82d243e
--- /dev/null
+++ b/src/dde_gear.c
@@ -0,0 +1,323 @@
+// v1h.1 gear selection. See dde_gear.h for the plain-English overview.
+// Sources: Ian's flexray-re-notes/analysis/egs_gear_report_tx.md/.csv (source of truth) and
+// egs-logs/F11_4log_r10md10m.csv (real DDE + EGS, engine running, PT-CAN = bus 3):
+//   P -> R  forward 1, 0x39A E1 +20 ms, 0x3FD 60 (N) +40 ms, forward 2 -> 0x3FD 40 (R) +40 ms
+//   R -> D  back 1 held 21 ms (skipped, no N shown), back 2 -> 0x3FD 80 (D) +40 ms
+//   D -> P  P button; 0x39A gear 01 +21 ms, 0x3FD 20 (P) +900 ms, pawl (0x39A E2,
+//           0x3F9 bits 28-29 = 2) +3.0 s (brake released +2.6 s)
+#include "dde_gear.h"
+#include <stdio.h>
+#include <string.h>
+
+#if defined(__arm__)
+#include "pico.h"
+#define GEAR_RAM(f) __time_critical_func(f)
+#else
+#define GEAR_RAM(f) f
+#endif
+
+static uint32_t GEAR_RAM(ms_since)(uint32_t now, uint32_t t) { return (now - t) / 1000u; }
+
+// The bytes the real EGS/DDE send in each gear: 0x3FD d2, 0x39A d3, d4, park bits, gear nibble, 0xDC d2, d5.
+typedef struct { uint8_t b3fd, a3, a4, park, nib, dc2, dc5; } gear_bytes_t;
+static const gear_bytes_t gb_gear[4] = {
+    [GEAR_P] = {0x20, 0x03, 0xE2, 2, 3, 0x22, 0xFE},   // capture, P with pawl (= v1h template)
+    [GEAR_R] = {0x40, 0x02, 0xE0, 0, 2, 0x25, 0xF4},   // capture
+    [GEAR_N] = {0x60, 0x01, 0xE0, 0, 1, 0x22, 0xFE},   // 0x3FD 60 capture; the rest HYPOTHESIS (Ian)
+    [GEAR_D] = {0x80, 0x05, 0xE0, 0, 5, 0x24, 0xF4},   // capture
+};
+static const gear_bytes_t gb_p_unlocked = {0x20, 0x03, 0xE0, 0, 3, 0x22, 0xFE};   // P shown, pawl not yet confirmed
+
+const char *gear_name(unsigned gear)
+{
+    static const char n[4][2] = {"P", "R", "N", "D"};
+    return gear < 4 ? n[gear] : "?";
+}
+
+static bool brake_on(const gear_t *g)
+{
+    return g->brake_have && ms_since(g->now, g->brake_us) <= GEAR_BRAKE_MS;
+}
+
+static void GEAR_RAM(log_ev)(gear_t *g, uint8_t kind, uint8_t from, uint8_t to, uint8_t why)
+{
+    memmove(&g->ev[0], &g->ev[1], sizeof(gear_ev_t) * (GEAR_N_EV - 1));
+    gear_ev_t *e = &g->ev[GEAR_N_EV - 1];
+    e->seq = ++g->ev_seq;
+    e->kind = kind;
+    e->from_to = (uint8_t)((from & 0x0Fu) | (to << 4));
+    e->why = why;
+    e->flags = (uint8_t)((brake_on(g) ? 1u : 0u) | (g->running ? 2u : 0u) | (uint8_t)(g->act_why << 4));
+    e->t_ms = (uint16_t)(g->now / 1000u);
+    if (kind == GEV_CHANGE) g->changes++;
+    if (kind == GEV_REFUSED) g->refusals++;
+}
+
+void gear_reset(gear_t *g, bool enabled)
+{
+    uint16_t seq = g->ev_seq, ch = g->changes, rf = g->refusals;
+    uint32_t lf = g->lever_frames, lb = g->lever_bad;
+    gear_ev_t ev[GEAR_N_EV];
+    memcpy(ev, g->ev, sizeof ev);
+    memset(g, 0, sizeof *g);
+    // counters and the event list survive a new wake (the logger reads them)
+    g->ev_seq = seq; g->changes = ch; g->refusals = rf; g->lever_frames = lf; g->lever_bad = lb;
+    memcpy(g->ev, ev, sizeof ev);
+    g->enabled = EMU_GEAR && enabled;
+    g->target = g->from = GEAR_P;
+    g->stage = GST_P_LOCKED;
+    g->lv = 0xFF;
+}
+
+void gear_set_enabled(gear_t *g, bool on, uint32_t now_us)
+{
+    on = EMU_GEAR && on;
+    if (on == g->enabled) return;
+    g->now = now_us;
+    uint8_t was = g->target;
+    g->enabled = on;
+    // off: straight back to the fixed v1h P content
+    if (!on) { g->target = g->from = GEAR_P; g->stage = GST_P_LOCKED; }
+    log_ev(g, GEV_ONOFF, was, g->target, on ? GWHY_ENABLED : GWHY_DISABLED);
+}
+
+void GEAR_RAM(gear_input_brake)(gear_t *g, uint32_t now_us)
+{
+    g->brake_have = true;
+    g->brake_us = now_us;
+}
+
+// Start a transition from the gear we are in (or heading to) to 'to'.
+static void GEAR_RAM(start)(gear_t *g, uint8_t to, uint8_t why)
+{
+    uint8_t cur = g->target;
+    log_ev(g, GEV_CHANGE, cur, to, why);
+    g->target = to;
+    g->t_act = g->now;
+    if (to == GEAR_P) {                                   // P button / engine off
+        g->from = cur;
+        g->stage = GST_TO_P; g->t_stage = g->now;
+    } else if (g->stage == GST_P_LOCKED || g->stage == GST_P_UNLOCKED || g->stage == GST_TO_P) {
+        g->from = GEAR_P;
+        g->stage = GST_LEAVE_P; g->t_stage = g->now;      // P released first
+    } else if (g->stage == GST_LEAVE_P) {
+        // 2nd notch while still releasing P (P -> N -> R): keep the release timing
+    } else {
+        g->from = to;
+        g->stage = GST_STEADY;                           // R / N / D: shown straight away
+    }
+}
+
+// One lever action. dir 1 = forward, 2 = back (depth 1/2 notches); dir 3 = P button.
+// The EGS table (Ian, egs_gear_report_tx.md):
+//              forward 1   forward 2   back 1   back 2    P button
+//   from P     N           R           D        D         (stays P)
+//   from R     -           -           N        D         P
+//   from N     R           R           D        D         P
+//   from D     N           R           -        -         P
+//   Out of P, and P/N -> R/D: engine running AND brake pressed, else refused (logged).
+static void GEAR_RAM(gear_act)(gear_t *g, uint8_t dir, uint8_t depth)
+{
+    const uint8_t cur = g->target;
+    uint8_t want = 0xFF, why;
+    if (dir == 3) {
+        why = GWHY_PBTN;
+        if (cur != GEAR_P) want = GEAR_P;
+    } else if (dir == 1) {
+        why = depth >= 2 ? GWHY_FWD2 : GWHY_FWD1;
+        switch (cur) {
+        case GEAR_P: want = depth >= 2 ? GEAR_R : GEAR_N; break;
+        case GEAR_N: want = GEAR_R; break;
+        case GEAR_D: want = depth >= 2 ? GEAR_R : GEAR_N; break;
+        default: break;                                    // R: nothing further forward
+        }
+    } else {
+        why = depth >= 2 ? GWHY_BACK2 : GWHY_BACK1;
+        switch (cur) {
+        case GEAR_P: want = GEAR_D; break;
+        case GEAR_N: want = GEAR_D; break;
+        case GEAR_R: want = depth >= 2 ? GEAR_D : GEAR_N; break;
+        default: break;                                    // D: nothing further back
+        }
+    }
+    if (want == 0xFF || want == cur) return;              // nothing to do (already there)
+    g->act_why = why;                                      // the lever move, for refusal texts
+    if (!g->enabled) return;                               // fixed P (logged once when switched off)
+    if (want != GEAR_P) {
+        if (!g->running) { log_ev(g, GEV_REFUSED, cur, want, GREF_NOT_RUNNING); return; }
+        // the brake: leaving P, and P/N -> R/D. The 2nd notch of the same push while we are
+        // still releasing P (P -> N -> R) was already checked at the first notch.
+        bool same_push = g->stage == GST_LEAVE_P;
+        bool need = cur == GEAR_P || (cur == GEAR_N && (want == GEAR_R || want == GEAR_D) && !same_push);
+        if (need && !brake_on(g)) { log_ev(g, GEV_REFUSED, cur, want, GREF_NO_BRAKE); return; }
+    }
+    start(g, want, why);
+}
+
+// PT-CAN 0x197 (GWS, 22/38 ms). B0 E2E CRC8 0x1D (data ID 0x3F, 4 bytes), B1 low = alive 0..14,
+// B2 high nibble = lever (0 centre, 1 fwd 1, 2 fwd 2, 3 back 1, 4 back 2; low nibble masked),
+// B3 = P button (C0 released, D5 pressed).
+void GEAR_RAM(gear_input_lever)(gear_t *g, const uint8_t *d, uint8_t len, uint32_t now_us)
+{
+    g->now = now_us;
+    if (len < 4) { g->lever_bad++; return; }
+    static const uint8_t id[2] = {0x3F, 0x00};
+    uint8_t crc = 0;
+    for (unsigned i = 0; i < 5u; i++) {
+        crc ^= i < 2 ? id[i] : d[i - 1];
+        for (int b = 0; b < 8; b++) crc = (uint8_t)((crc & 0x80) ? (crc << 1) ^ 0x1D : crc << 1);
+    }
+    if (crc != d[0]) { g->lever_bad++; return; }
+    g->lever_frames++;
+    if (g->lv_lost) { g->lv_lost = false; log_ev(g, GEV_LEVER_OK, g->target, g->target, 0); }
+    const uint8_t pos = (uint8_t)((d[2] & 0xF0u) >> 4);
+    const uint8_t pb = d[3] & 0x3Fu;
+    g->lv_have = true; g->lv_us = now_us; g->lv = pos;
+    g->pbtn = pb == 0x15u;
+    // lever: remember the deepest notch of this push; gear_step() acts on it 40 ms after it appeared
+    if (pos == LV_CENTRE) {
+        g->gest_dir = 0; g->gest_depth = 0;
+    } else if (pos >= LV_FWD1 && pos <= LV_BACK2) {
+        uint8_t dir = pos <= LV_FWD2 ? 1 : 2, depth = (pos == LV_FWD2 || pos == LV_BACK2) ? 2 : 1;
+        bool new_push = g->gest_dir == 0 && g->pend_dir == 0;
+        bool deeper = (g->pend_dir ? g->pend_dir : g->gest_dir) == dir &&
+                      depth > (g->pend_dir ? g->pend_depth : g->gest_depth);
+        if (new_push || deeper) {
+            if (g->pend_dir == 0) g->pend_us = now_us;   // a deeper notch replaces a waiting one
+            else if (deeper) g->pend_us = now_us;
+            g->pend_dir = dir; g->pend_depth = depth;
+            if (g->gest_dir == 0) g->gest_dir = dir;       // push in progress
+        }
+    }   // other values (side gate M/S, +/-; not on this car): ignored
+    // P button: two pressed frames in a row (~40 ms), once per press
+    if (pb == 0x15u) {
+        if (g->pbtn_cnt < 255) g->pbtn_cnt++;
+        if (g->pbtn_cnt >= 2 && !g->pbtn_done) { g->pbtn_done = true; gear_act(g, 3, 0); }
+    } else if (pb == 0x00u) {
+        g->pbtn_cnt = 0; g->pbtn_done = false;
+    }
+}
+
+void GEAR_RAM(gear_step)(gear_t *g, uint32_t now_us, bool running)
+{
+    g->now = now_us;
+    g->running = running;
+    if (g->lv_have && ms_since(now_us, g->lv_us) > GEAR_LEVER_STALE_MS) {
+        // lever timeout: hold the gear, forget the push, say so once
+        g->lv_have = false; g->lv = 0xFF; g->gest_dir = 0; g->gest_depth = 0; g->pend_dir = 0;
+        g->pbtn_cnt = 0;
+        if (!g->lv_lost) { g->lv_lost = true; log_ev(g, GEV_LEVER_LOST, g->target, g->target, 0); }
+    }
+    // the waiting notch is due (40 ms after it first appeared)
+    if (g->pend_dir && ms_since(now_us, g->pend_us) >= GEAR_ACT_MS) {
+        uint8_t dir = g->pend_dir, depth = g->pend_depth;
+        g->pend_dir = 0;
+        g->gest_depth = depth;
+        gear_act(g, dir, depth);
+    }
+    if (!g->enabled) return;
+    // no engine: P (BMW auto-P when the engine goes off in R / N / D)
+    if (!running && g->target != GEAR_P) { g->act_why = 0; start(g, GEAR_P, GWHY_ENGINE_OFF); }
+    const uint32_t ts = ms_since(now_us, g->t_stage), ta = ms_since(now_us, g->t_act);
+    switch (g->stage) {
+    case GST_LEAVE_P:
+        if (ts >= GEAR_LEAVE_P_MS) { g->stage = GST_STEADY; g->from = g->target; }
+        break;
+    case GST_TO_P:
+        if (ts >= GEAR_TO_P_MS) { g->stage = GST_P_UNLOCKED; g->t_stage = now_us; g->from = GEAR_P; }
+        break;
+    case GST_P_UNLOCKED:
+        // pawl confirmed: brake released, or 3 s after the P request at the latest
+        if (!brake_on(g) || ta >= GEAR_PLOCK_MS) {
+            g->stage = GST_P_LOCKED; log_ev(g, GEV_LOCKED, GEAR_P, GEAR_P, 0);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void GEAR_RAM(gear_fill_out)(const gear_t *g, eng_out_t *o)
+{
+    o->g_set = 0;
+    if (!g->enabled || g->stage == GST_P_LOCKED) return;   // fixed P content (as v1h)
+    gear_bytes_t b;
+    switch (g->stage) {
+    case GST_LEAVE_P:
+        // P released: 0x39A still gear 03 with E1, 0x3F9 bits 28-29 = 1; 0x3FD already the new gear
+        b = gb_gear[GEAR_P];
+        b.a4 = 0xE1; b.park = 1;
+        b.b3fd = gb_gear[g->target & 3u].b3fd;
+        // P -> R: the real EGS shows N (0x3FD 60) for these ~60 ms, then R (Ian's report)
+        if (g->target == GEAR_R) b.b3fd = gb_gear[GEAR_N].b3fd;
+        break;
+    case GST_STEADY:
+        b = gb_gear[g->target & 3u];
+        break;
+    case GST_TO_P:
+        // "P coming": 0x39A gear 01, 0x3F9 gear 1, 0xDC 22 FC; 0x3FD keeps the old gear
+        b = gb_gear[g->from & 3u];
+        if (g->from == GEAR_P) b = gb_p_unlocked;
+        b.a3 = 0x01; b.nib = 1; b.dc2 = 0x22; b.dc5 = 0xFC;
+        break;
+    default:   // GST_P_UNLOCKED
+        b = gb_p_unlocked;
+        break;
+    }
+    o->g_set = 1;
+    o->g_3fd = b.b3fd; o->g_39a_d3 = b.a3; o->g_39a_d4 = b.a4;
+    o->g_park = b.park; o->g_nib = b.nib; o->g_dc_b2 = b.dc2; o->g_dc_b5 = b.dc5;
+}
+
+void gear_fill_status(const gear_t *g, dde_gear_status_t *st)
+{
+    memset(st, 0, sizeof *st);
+    st->version = 1;
+    st->enabled = (uint8_t)((g->enabled ? 1u : 0u) | (EMU_GEAR ? 2u : 0u));
+    st->gear = g->target;
+    st->stage = g->stage;
+    st->lever = g->lv_have ? g->lv : 0xFF;
+    st->pbtn = g->lv_have && g->pbtn;
+    st->brake = brake_on(g);
+    st->running = g->running;
+    st->ev_seq = g->ev_seq; st->changes = g->changes; st->refusals = g->refusals;
+    st->lever_frames = g->lever_frames; st->lever_bad = g->lever_bad;
+    memcpy(st->ev, g->ev, sizeof st->ev);
+}
+
+static const char *why_text(uint8_t why)
+{
+    switch (why) {
+    case GWHY_FWD1: return "lever forward 1";
+    case GWHY_FWD2: return "lever forward 2";
+    case GWHY_BACK1: return "lever back 1";
+    case GWHY_BACK2: return "lever back 2";
+    case GWHY_PBTN: return "P button";
+    case GWHY_ENGINE_OFF: return "engine not running: auto P";
+    default: return "";
+    }
+}
+
+int gear_ev_text(const gear_ev_t *e, char *buf, unsigned n)
+{
+    const char *f = gear_name(e->from_to & 0x0Fu), *t = gear_name(e->from_to >> 4);
+    const char *br = (e->flags & 1u) ? "brake on" : "brake off";
+    switch (e->kind) {
+    case GEV_CHANGE:
+        return snprintf(buf, n, "GEAR: %s -> %s (%s) %s", f, t, br, why_text(e->why));
+    case GEV_REFUSED:
+        return snprintf(buf, n, "GEAR: refused, %s (%s -> %s, %s)",
+                        e->why == GREF_NO_BRAKE ? "brake not pressed" : "engine not running", f, t,
+                        why_text((uint8_t)(e->flags >> 4)));
+    case GEV_LOCKED:
+        return snprintf(buf, n, "GEAR: P pawl confirmed (0x39A E2, 0x3F9 bits 28-29 = 2)");
+    case GEV_LEVER_LOST:
+        return snprintf(buf, n, "GEAR: lever 0x197 lost (no valid frame for 90 ms), holding %s", t);
+    case GEV_LEVER_OK:
+        return snprintf(buf, n, "GEAR: lever 0x197 back");
+    case GEV_ONOFF:
+        return snprintf(buf, n, "GEAR: shifting %s", e->why == GWHY_ENABLED ? "on" : "off (fixed P as v1h)");
+    default:
+        return snprintf(buf, n, "GEAR: event %u", e->kind);
+    }
+}
diff --git a/src/dde_gear.h b/src/dde_gear.h
new file mode 100644
index 0000000..b50538d
--- /dev/null
+++ b/src/dde_gear.h
@@ -0,0 +1,136 @@
+// v1h.1: gear selection for the DDE/EGS emulator (no real gearbox in the car).
+//
+// Plain English: with the real EGS gone nobody answers the gear lever, so the
+// car always shows P. This module reads the driver's lever (GWS frame 0x197 on
+// PT-CAN, received only - we never send 0x197) and the brake (PT-CAN 0x173),
+// decides which gear the driver asked for, and tells the frame builders which
+// bytes to put in the EGS/DDE frames the emulator ALREADY sends, so the dash and
+// the selector show P / R / N / D like the real EGS would.
+//
+// Shift rules (Ian's egs_gear_report_tx.md = the real EGS table; state machine in
+// gear_act() in dde_gear.c):
+//   From P:  forward 1 = N, forward 2 = R, back (1 or 2) = D.
+//   From R:  back 1 = N, back 2 = D.
+//   From N:  forward = R, back = D.
+//   From D:  forward 1 = N, forward 2 = R.
+//   P button = P from R / N / D (we have no road speed here: standstill assumed).
+//   * Leaving P needs the engine "running" (our fake engine in RUN) AND the brake
+//     pressed (0x173 d7 bits 0-1 == 3 in the last 250 ms). P/N -> R/D also needs the
+//     brake (BMW shiftlock). No brake-off shift was ever captured: HYPOTHESIS, logged.
+//   * We act 40 ms after a lever notch first appears, on the deepest notch reached
+//     in that push (the real EGS: 0x3FD changes 40 ms after the lever frame; a notch
+//     held only ~21 ms on the way to the 2nd notch is skipped). One action per notch,
+//     a new push only after the lever was back in the centre.
+//   * No valid 0x197 for 90 ms (the EGS timeout): we stay in gear and log it.
+//   * Engine not running: stays in P (moves are refused and logged); if the engine
+//     stops while in R/N/D we go to P automatically (BMW auto-P).
+//   * There is no unlock button in 0x197: the GWS gates the lever itself using 0x3FD,
+//     so 0x3FD always shows the gear we have really accepted.
+//   * Switched off (build EMU_GEAR=0 or logger --no-gear): fixed P exactly as v1h.
+//
+// Byte values: every value for P, R, D, the P release and the P-engage sequence is
+// copied from the real EGS (F11_4log_r10md10m.csv, Ian's report). N was only ever
+// seen for 60 ms on the way from P to R: 0x3FD 0x60 is real, the rest of N
+// (0x39A gear 01, 0x3F9/0xE6 gear nibble 1, 0xDC/0x28 22 FE) is HYPOTHESIS.
+//
+// Pure C (no SDK): the firmware runs gear_step() on core 1 once per FlexRay cycle,
+// the host test (tests/host/test_gear.c) runs it with simulated time and with the
+// real lever/brake frames of the capture.
+#ifndef DDE_GEAR_H
+#define DDE_GEAR_H
+#include <stdbool.h>
+#include <stdint.h>
+#include "dde_engine.h"
+
+#ifndef EMU_GEAR
+#define EMU_GEAR 1          // build option (CMake EMU_GEAR): 0 = compiled out, fixed P
+#endif
+
+enum { GEAR_P = 0, GEAR_R = 1, GEAR_N = 2, GEAR_D = 3 };
+// what the bytes show right now
+enum { GST_P_LOCKED = 0,    // P with the parking pawl in (= the v1h fixed-P content, nothing patched)
+       GST_LEAVE_P,         // P released (0x39A E1, 0x3F9 bits 28-29 = 1) for 60 ms, new gear on 0x3FD (N on the way to R)
+       GST_STEADY,          // in R, N or D
+       GST_TO_P,            // P button: 0x39A gear 01, old gear still on 0x3FD, for 900 ms
+       GST_P_UNLOCKED };    // P shown, pawl confirmed when the brake is released or 3 s after the button
+// lever positions (0x197 B2 >> 4)
+enum { LV_CENTRE = 0, LV_FWD1 = 1, LV_FWD2 = 2, LV_BACK1 = 3, LV_BACK2 = 4 };
+// event kinds / reasons
+enum { GEV_CHANGE = 1, GEV_REFUSED = 2, GEV_LOCKED = 3, GEV_ONOFF = 4, GEV_LEVER_LOST = 5, GEV_LEVER_OK = 6 };
+enum { GWHY_FWD1 = 1, GWHY_FWD2, GWHY_BACK1, GWHY_BACK2, GWHY_PBTN, GWHY_ENGINE_OFF, GWHY_DISABLED,
+       GWHY_ENABLED,
+       GREF_NO_BRAKE = 16, GREF_NOT_RUNNING };
+
+// timings (ms), from the capture / Ian's report
+#define GEAR_BRAKE_MS        250u   // brake "pressed" if a pressed 0x173 came in the last 250 ms
+#define GEAR_LEVER_STALE_MS   90u   // no valid 0x197 for this long: lever lost (EGS timeout 90 ms)
+#define GEAR_ACT_MS           40u   // act 40 ms after a notch first appears (0x3FD +40 +-1 ms)
+#define GEAR_LEAVE_P_MS       60u   // P released (E1 / bits 1) for 60 ms after the act (~100 ms after the lever)
+#define GEAR_TO_P_MS         880u   // P button act -> P shown (real: +900 ms after the button frame)
+#define GEAR_PLOCK_MS       3000u   // pawl confirmed 3 s after the P button at the latest ...
+                                    // ... or as soon as the brake is released (real: +3.0 s, brake off +2.6 s)
+
+#define GEAR_N_EV 5
+typedef struct __attribute__((packed)) {
+    uint16_t seq;           // event number (1, 2, ...)
+    uint8_t kind;           // GEV_*
+    uint8_t from_to;        // low nibble from gear, high nibble to gear (GEAR_*)
+    uint8_t why;            // GWHY_* / GREF_*
+    uint8_t flags;          // bit0 brake pressed, bit1 engine running, bits 4-7 lever move (GWHY_*)
+    uint16_t t_ms;          // low 16 bits of the firmware ms clock
+} gear_ev_t;
+
+// USB 0xab (PICOFLEX_GET_GEAR) / UART. 64 bytes.
+typedef struct __attribute__((packed)) {
+    uint8_t version;        // 1
+    uint8_t enabled;        // bit0 on (0 = fixed P), bit1 compiled in
+    uint8_t gear;           // GEAR_* we are in / heading to
+    uint8_t stage;          // GST_*
+    uint8_t lever;          // last valid 0x197 B2 >> 4 (0xFF = none)
+    uint8_t pbtn;           // 1 = P button pressed in the last valid 0x197
+    uint8_t brake;          // 1 = brake pressed (0x173, last 250 ms)
+    uint8_t running;        // 1 = fake engine running
+    uint16_t ev_seq;        // events so far (ev[] holds the last GEAR_N_EV, oldest first)
+    uint16_t changes;
+    uint16_t refusals;
+    uint16_t reserved;
+    uint32_t lever_frames;  // valid 0x197 frames
+    uint32_t lever_bad;     // 0x197 with a bad length / E2E CRC
+    gear_ev_t ev[GEAR_N_EV];
+} dde_gear_status_t;
+_Static_assert(sizeof(dde_gear_status_t) == 64, "gear status size");
+
+typedef struct {
+    bool enabled;
+    uint8_t target;         // GEAR_*
+    uint8_t from;           // gear shown before the current transition
+    uint8_t stage;
+    uint32_t t_stage, t_act;
+    // lever
+    bool lv_have; uint32_t lv_us; uint8_t lv, pbtn;
+    bool lv_lost;                   // lever was seen and then timed out (logged once)
+    uint8_t gest_dir, gest_depth;   // current push: 0 none, 1 forward, 2 back; deepest notch acted on
+    uint8_t pend_dir, pend_depth;   // notch waiting for its 40 ms (0 = none)
+    uint32_t pend_us;
+    uint8_t pbtn_cnt; bool pbtn_done;
+    bool brake_have; uint32_t brake_us;
+    bool running;
+    uint8_t act_why;                // GWHY_* of the move being handled
+    uint32_t now;
+    // bookkeeping
+    uint16_t ev_seq, changes, refusals;
+    uint32_t lever_frames, lever_bad;
+    gear_ev_t ev[GEAR_N_EV];
+} gear_t;
+
+void gear_reset(gear_t *g, bool enabled);                    // power-up / new FlexRay wake: P
+void gear_set_enabled(gear_t *g, bool on, uint32_t now_us);  // runtime switch (logger --no-gear)
+void gear_input_lever(gear_t *g, const uint8_t *d, uint8_t len, uint32_t now_us);   // PT-CAN 0x197
+void gear_input_brake(gear_t *g, uint32_t now_us);           // a PT-CAN 0x173 with d7 & 3 == 3
+void gear_step(gear_t *g, uint32_t now_us, bool running);    // once per FlexRay cycle
+void gear_fill_out(const gear_t *g, eng_out_t *o);           // bytes for the frame builders
+void gear_fill_status(const gear_t *g, dde_gear_status_t *st);
+const char *gear_name(unsigned gear);
+// "GEAR: P -> R (brake on) lever forward 2" / "GEAR: refused, brake not pressed (P -> R, lever forward 2)"
+int gear_ev_text(const gear_ev_t *e, char *buf, unsigned n);
+#endif
diff --git a/src/dde_standalone.c b/src/dde_standalone.c
new file mode 100644
index 0000000..41d342a
--- /dev/null
+++ b/src/dde_standalone.c
@@ -0,0 +1,116 @@
+// v1h.1 standalone build: emulate at power-up, no laptop needed. See dde_standalone.h.
+#include "dde_standalone.h"
+
+bool dde_standalone_led(uint8_t state, uint32_t ms)
+{
+    switch (state) {
+    case SA_LED_FAULT:     return ((ms / 100u) & 1u) == 0;    // fast blink: 0.1 s on, 0.1 s off
+    case SA_LED_EMULATING: return ((ms / 500u) & 1u) == 0;    // slow blink: 0.5 s on, 0.5 s off
+    default:               return (ms % 2000u) < 100u;        // short flash every 2 s: waiting for the car
+    }
+}
+
+#if EMU_STANDALONE
+#include <stdio.h>
+#include "pico/stdlib.h"
+#include "dde_emu.h"
+#include "dde_engine.h"
+#if PICO_FLEXRAY_BOARD_V2 && EMU_CAN_TX
+#include "ptcan_emu.h"
+#include "ptcan_emu_core.h"
+#endif
+#if !PICO_FLEXRAY_BOARD_V2
+#include "hardware/gpio.h"
+#include "hardware/sync.h"   // __sev()
+#include "flexray_pins.h"
+#endif
+
+static uint32_t next_refresh_ms;       // when to re-send the settings
+static uint32_t next_state_ms;         // when to look at the emulator state again
+static volatile uint32_t host_cmd_ms;  // last switch from a laptop
+static volatile bool host_cmd_seen;
+static volatile uint8_t led_state = SA_LED_WAITING;
+static bool announced;
+
+static uint32_t ms_now(void) { return to_ms_since_boot(get_absolute_time()); }
+
+void dde_standalone_host_cmd(void)
+{
+    host_cmd_ms = ms_now();
+    host_cmd_seen = true;
+}
+
+uint8_t dde_standalone_led_state(void) { return led_state; }
+
+// Send the logger's start settings to ourselves (the same calls the USB requests make).
+static void apply_settings(void)
+{
+    dde_emu_host_set((uint16_t)SA_EMU_ON);                                    // FlexRay emulator TX on
+#if PICO_FLEXRAY_BOARD_V2 && EMU_CAN_TX
+    ptcan_emu_host_set(PTE_MASK_ALL);                                         // PT-CAN TX, all frames (= --can-tx)
+#endif
+    dde_engine_host_set((uint16_t)SA_ENGINE_MODE, (uint16_t)SA_ENGINE_PROFILE); // fake start cas, short, gear on
+}
+
+#if !PICO_FLEXRAY_BOARD_V2
+// V1: the LED (GP20) is driven from a 50 ms timer so it keeps blinking even while the
+// main loop sleeps (no car bus, no USB). The timer also wakes the main loop (__sev),
+// so the settings are refreshed even when nothing else happens.
+static repeating_timer_t v1_led_timer;
+static bool v1_led_cb(repeating_timer_t *t)
+{
+    (void)t;
+    gpio_put(LED_PIN, dde_standalone_led(led_state, ms_now()));
+    __sev();
+    return true;
+}
+#endif
+
+void dde_standalone_start(void)
+{
+    printf("--- STANDALONE build: emulating from power-up with the settings of\n"
+           "    fr_ts_logger.py --emulate --can-tx --fake-start cas --start-profile short (gear %s)\n"
+           "    no USB host needed; LED: flash every 2 s = waiting for the car, slow blink = emulating,\n"
+           "    fast blink = fault (power off and on to clear a latched fault) ---\n",
+           EMU_GEAR ? "on" : "off (fixed P)");
+    apply_settings();
+    next_refresh_ms = ms_now() + SA_REFRESH_MS;
+#if !PICO_FLEXRAY_BOARD_V2
+    add_repeating_timer_ms(-50, v1_led_cb, NULL, &v1_led_timer);
+#endif
+}
+
+void dde_standalone_poll(void)
+{
+    uint32_t now = ms_now();
+    if ((int32_t)(now - next_refresh_ms) >= 0) {
+        next_refresh_ms = now + SA_REFRESH_MS;
+        // a laptop that is actively switching things wins; 25 s after its last switch
+        // (longer than any firmware keepalive) the standalone settings come back
+        if (!host_cmd_seen || (uint32_t)(now - host_cmd_ms) > SA_HOST_HOLD_MS) {
+            if (host_cmd_seen) {
+                host_cmd_seen = false;
+                printf("standalone: no switches from the laptop for %u s, standalone settings back\n",
+                       (unsigned)(SA_HOST_HOLD_MS / 1000u));
+            }
+            apply_settings();
+        }
+    }
+    if ((int32_t)(now - next_state_ms) >= 0) {
+        next_state_ms = now + 50u;
+        static dde_emu_stats_t st;
+        dde_emu_fill_stats(&st);
+        uint8_t s = SA_LED_WAITING;
+        if (st.fault || st.state == DDE_EMU_ST_FAULT) s = SA_LED_FAULT;
+        else if (st.state == DDE_EMU_ST_ACTIVE) s = SA_LED_EMULATING;
+#if PICO_FLEXRAY_BOARD_V2 && EMU_CAN_TX
+        if (ptcan_emu_fault()) s = SA_LED_FAULT;
+#endif
+        if (s == SA_LED_EMULATING && !announced) {
+            announced = true;
+            printf("standalone: emulating (FlexRay TX active)\n");
+        }
+        led_state = s;
+    }
+}
+#endif
diff --git a/src/dde_standalone.h b/src/dde_standalone.h
new file mode 100644
index 0000000..5a46d53
--- /dev/null
+++ b/src/dde_standalone.h
@@ -0,0 +1,56 @@
+// v1h.1 standalone build: emulate at power-up, no laptop needed.
+//
+// In plain words
+// --------------
+// The normal emulator image does nothing on its own: the laptop logger switches the
+// FlexRay emulator on (USB 0xa3), PT-CAN TX on (0xa5, V2 board), the fake engine start
+// on (0xa7) and then repeats those switches every 1..2 s ("keepalive"). If the laptop
+// stops, the firmware switches everything off again after 3..20 s.
+//
+// The standalone image (CMake -DEMU_STANDALONE=1) plays the laptop's part itself, with
+// exactly the settings of
+//     fr_ts_logger.py --emulate --can-tx --fake-start cas --start-profile short
+// (gear shifting on): from power-up, without waiting for USB, and it keeps them up for
+// as long as the board has power. A laptop may still be plugged in to watch the
+// console or log. If the laptop sends its own switches, those win for as long as it
+// keeps sending them (plus 25 s), then the standalone settings come back.
+//
+// What it does NOT do: it never clears a latched fault. A fault that latches (for
+// example a second sender of one of our IDs = the real DDE is still on the bus, or
+// the CAN chip went bus-off) stays until the board is powered off and on again.
+// The LED says which state it is in (see dde_standalone_led()).
+#ifndef DDE_STANDALONE_H
+#define DDE_STANDALONE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifndef EMU_STANDALONE
+#define EMU_STANDALONE 0
+#endif
+
+// LED states
+enum {
+    SA_LED_WAITING = 0,   // powered, waiting for the car's FlexRay bus (one short flash every 2 s)
+    SA_LED_EMULATING = 1, // emulating (FlexRay TX active): slow blink, 0.5 s on / 0.5 s off
+    SA_LED_FAULT = 2,     // a fault (FlexRay emulator or PT-CAN TX): fast blink, 0.1 s on / 0.1 s off
+};
+
+#if EMU_STANDALONE
+// The settings the logger normally sends at start (compile-time defaults).
+#define SA_EMU_ON 1u                 // = --emulate (USB 0xa3 wValue 1)
+#define SA_ENGINE_MODE 1u            // = --fake-start cas (ENG_MODE_CAS)
+#define SA_ENGINE_PROFILE 1u         // = --start-profile short (ENG_PROF_SHORT); gear on (wIndex bit 8 clear)
+#define SA_REFRESH_MS 1000u          // re-send them every second, like the logger
+#define SA_HOST_HOLD_MS 25000u       // after the last switch from a laptop, leave it alone this long
+
+void dde_standalone_start(void);         // core0, once, before the main loop
+void dde_standalone_poll(void);          // core0 main loop: never blocks
+void dde_standalone_host_cmd(void);      // panda_usb.c: the laptop sent 0xa3/0xa5/0xa7
+uint8_t dde_standalone_led_state(void);  // SA_LED_*
+#endif
+
+// LED on/off for a state at time ms (pure, also used by the host test).
+bool dde_standalone_led(uint8_t state, uint32_t ms);
+
+#endif
