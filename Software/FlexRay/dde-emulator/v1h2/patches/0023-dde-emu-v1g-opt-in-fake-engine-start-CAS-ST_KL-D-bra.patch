+    CHECK(n_fast > 50 && e8_iv > 50 && e8_iv < 70, "E8 L9 ~15/s while running (%u, %.1f ms)", n_fast, e8_iv);
+    CHECK(n_fb9 >= 60, "FB L9 sent on change while ramping (%u)", n_fb9);
