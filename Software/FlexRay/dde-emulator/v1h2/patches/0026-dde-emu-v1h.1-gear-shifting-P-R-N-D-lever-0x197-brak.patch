+    led1(dde_standalone_led(dde_standalone_led_state(), n * V2_CAN_TICK_MS));
+#else
     if ((n % half_s) == 0) led1(((n / half_s) & 1) != 0); // 1 Hz heartbeat
+#endif
     tick_due = true;
     __sev();
     return true;
