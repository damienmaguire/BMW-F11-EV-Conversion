+    f, t = gear_name(e["from_to"] & 15), gear_name(e["from_to"] >> 4)
+    br = "brake on" if e["flags"] & 1 else "brake off"
+    k = e["kind"]
+    if k == 1:
+        return "GEAR: %s -> %s (%s) %s" % (f, t, br, GEAR_WHY.get(e["why"], ""))
+    if k == 2:
