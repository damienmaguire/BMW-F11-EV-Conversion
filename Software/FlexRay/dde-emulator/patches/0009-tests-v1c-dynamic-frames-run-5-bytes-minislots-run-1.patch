 tests/host/emu_stubs/sim_hw.h    |    6 +
 tests/host/run.sh                |   64 +-
 tests/host/test_dde_emu_core.c   |  243 ++-
 tests/host/test_dde_emu_replay.c |  550 +++++-
 tools/dde_emu/extract_dyn.py     |   50 +
 tools/dde_emu/extract_replay.py  |   45 +-
 7 files changed, 3673 insertions(+), 47 deletions(-)
 create mode 100644 tests/host/dde_dyn_run5.txt
