+    uint32_t w[DDE_TX_MAX_WORDS], w2[DDE_TX_MAX_WORDS];
+    unsigned nw = dde_core_pack(b, 14, 7, 56, w);
+    CHECK(nw == 6, "14 bytes = 6 words (got %u)", nw);
+    b[14] = 0xEE; b[15] = 0xEE;
