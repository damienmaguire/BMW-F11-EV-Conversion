diff --git a/src/ptcan_emu_core.c b/src/ptcan_emu_core.c
index 33f811d..5151f3b 100644
--- a/src/ptcan_emu_core.c
+++ b/src/ptcan_emu_core.c
@@ -243,6 +243,32 @@ void pte_on_rx(pte_t *p, uint16_t id, const uint8_t *data, uint8_t len, uint64_t
 // ---- content ------------------------------------------------------------------
 static inline uint64_t since(uint64_t now, uint64_t t) { return now >= t ? now - t : 0; }
 
+// 0x397 "e3" blips of the real DDE (run 4 ddecan): first at W+1.321 s, then these gaps
+// in ms (start to start), repeating. Each blip lasts 60 ms (shorter if the next one
+// starts sooner).
+static const uint16_t blip397_ms[] = {
+    4120, 840, 2240, 360, 540, 60, 780, 3260, 4040, 1380, 540, 1120, 1000, 420, 1760, 220,
+    180, 460, 1320, 1060, 1560, 1500, 1620, 3940, 260, 2020, 6420, 1560, 580, 2860, 1500,
+    840, 1660, 1620, 1540, 2440, 480, 4020, 1340, 120, 4019, 4040, 8660, 3820, 3560, 120,
+    720, 1300, 3939, 4140, 1920, 1000, 800, 220, 6220, 1860, 1340, 3160, 5180, 2440, 2560,
+    2000,
+};
+#define BLIP397_FIRST_US MS(1321)
+static bool blip397(uint64_t tw)
+{
+    static uint32_t cycle_ms;
+    if (!cycle_ms)
+        for (unsigned k = 0; k < sizeof blip397_ms / sizeof blip397_ms[0]; k++) cycle_ms += blip397_ms[k];
+    if (tw < BLIP397_FIRST_US) return false;
+    uint32_t pos = (uint32_t)(((tw - BLIP397_FIRST_US) / 1000u) % cycle_ms);
+    for (unsigned k = 0; k < sizeof blip397_ms / sizeof blip397_ms[0]; k++) {
+        uint32_t len = blip397_ms[k] < 80 ? blip397_ms[k] - 20u : 60u;
+        if (pos < blip397_ms[k]) return pos < len;
+        pos -= blip397_ms[k];
+    }
+    return false;
+}
+
 // Is the frame active (allowed to be sent) at now? (Ignoring the bus gate.)
 static bool frame_active(const pte_t *p, int i, uint64_t now)
 {
@@ -396,13 +422,29 @@ static void build(const pte_t *p, int i, uint64_t now, uint8_t *d)
         break;
     }
     case PTE_F_397: {
-        // wake ramp fe e8 e9 e6 e4 -> e2 (the occasional 60 ms e3 blips are not reproduced)
+        // v1f: as the real DDE in run 4 (ddecan). Byte 1:
+        //  - wake ramp fe e8 e9 e6 e4, then e2;
+        //  - short "e3" blips (e3 for 60 ms, then back to e2) at irregular intervals,
+        //    replayed from the capture (blip397_ms[], repeating); each change goes out
+        //    at once as an event copy, which is why the real frame averages ~380 ms;
+        //  - after KL15 off the d1 walk df de dd de dd de dd de dd (first 0.8 s), dd held,
+        //    df at OFF+4.073 s, back to e2 at OFF+4.133 s (no blips during the walk).
         uint8_t b = 0xe2;
         if (tw < MS(461)) b = 0xfe;
         else if (tw < MS(481)) b = 0xe8;
         else if (tw < MS(541)) b = 0xe9;
         else if (tw < MS(601)) b = 0xe6;
         else if (tw < MS(661)) b = 0xe4;
+        else if (blip397(tw)) b = 0xe3;
+        if (!on && ever && toff < MS(4133)) {
+            static const struct { uint16_t ms; uint8_t v; } walk[] = {
+                {93, 0xdf}, {153, 0xde}, {273, 0xdd}, {373, 0xde}, {434, 0xdd}, {513, 0xde},
+                {634, 0xdd}, {713, 0xde}, {773, 0xdd}, {4073, 0xdf},
+            };
+            for (unsigned k = 0; k < sizeof walk / sizeof walk[0]; k++)
+                if (toff >= MS(walk[k].ms)) b = walk[k].v;
+            if (toff < MS(93)) b = 0xe2;
+        }
         d[0] = 0xc0; d[1] = b; d[2] = 0x00;
         break;
     }
@@ -459,6 +501,7 @@ bool pte_next(pte_t *p, uint64_t now, pte_tx_t *out)
     int best = -1;
     uint64_t best_due = 0;
     uint8_t best_d[8];
+    bool best_cyc = false;
     for (int i = 0; i < PTE_N_FRAMES; i++) {
         if (!(p->mask & (1u << i))) continue;
         const pte_def_t *def = &pte_defs[i];
@@ -466,6 +509,7 @@ bool pte_next(pte_t *p, uint64_t now, pte_tx_t *out)
         if (pte_id_forbidden(def->id)) continue;
         if (!frame_active(p, i, now)) continue;
         uint64_t due;
+        bool cyc = true;
         uint8_t d[8];
         build(p, i, now, d);
         if (def->kind == PTE_K_NM512 && !p->kl15_ever) {
@@ -477,13 +521,16 @@ bool pte_next(pte_t *p, uint64_t now, pte_tx_t *out)
         } else {
             due = f->next_us;
             if (def->kind == PTE_K_CYC_EVENT && payload_differs(def, d, f->last) &&
-                now >= f->last_tx_us + MS(def->ev_gap_ms))
+                now >= f->last_tx_us + MS(def->ev_gap_ms) && now < due) {
                 due = now;   // on change
+                cyc = false;
+            }
         }
         if (now < due) continue;
         if (best < 0 || due < best_due) {
             best = i;
             best_due = due;
+            best_cyc = cyc;
             memcpy(best_d, d, 8);
         }
     }
@@ -492,6 +539,8 @@ bool pte_next(pte_t *p, uint64_t now, pte_tx_t *out)
     out->idx = (uint8_t)best;
     out->id = def->id;
     out->dlc = def->dlc;
+    out->due_us = best_due;
+    out->cyclic_slot = best_cyc && (def->kind == PTE_K_CYCLIC || def->kind == PTE_K_CYC_EVENT) && p->f[best].started;
     memcpy(out->data, best_d, 8);
     if (def->data_id != NO_E2E) {
         uint8_t c = p->f[best].ctr;
@@ -515,7 +564,8 @@ void pte_commit(pte_t *p, const pte_tx_t *tx, uint64_t now)
             f->nm_pre_idx++;
             f->next_us = now + period;
         } else {
-            f->next_us = (f->next_us + period > now) ? f->next_us + period : now + period;
+            f->next_us += period;   // keep the NM grid (late slot still goes out)
+            if (f->next_us + PTE_CATCHUP_MAX_US <= now) { p->resyncs++; f->next_us = now + period; }
         }
         break;
     case PTE_K_CC592:
@@ -525,12 +575,24 @@ void pte_commit(pte_t *p, const pte_tx_t *tx, uint64_t now)
     default:
         if (!f->started) f->next_us = now + period;
         else if (now >= f->next_us) {
-            // cyclic slot (events do not move the grid); if far behind, restart the grid
+            // Cyclic slot (event copies do not move the grid). v1f: keep the grid even if
+            // we are late, so a frame that missed its slot still goes out (late) instead of
+            // being skipped; only if we are hopelessly behind, restart the grid from now.
             f->next_us += period;
-            if (f->next_us <= now) f->next_us = now + period;
+            if (f->next_us <= now) {
+                if (now - f->next_us > PTE_CATCHUP_MAX_US) {
+                    p->resyncs++;
+                    f->next_us = now + period;
+                }
+            }
         }
         break;
     }
+    if (tx->cyclic_slot && now > tx->due_us) {
+        uint64_t late = now - tx->due_us;
+        if (late > PTE_LATE_US) p->late_sends++;
+        if (late > p->late_max_us) p->late_max_us = late > 0xFFFFFFFFu ? 0xFFFFFFFFu : (uint32_t)late;
+    }
     f->started = true;
     f->last_tx_us = now;
     memcpy(f->last, tx->data, 8);
diff --git a/src/ptcan_emu_core.h b/src/ptcan_emu_core.h
index a28aef6..4933ce3 100644
--- a/src/ptcan_emu_core.h
+++ b/src/ptcan_emu_core.h
@@ -45,10 +45,22 @@ extern const pte_def_t pte_defs[PTE_N_FRAMES];
 #define PTE_NEW_WAKE_US     1000000u  // silence >= 1 s: the next frame is a new wake (restart timelines)
 #define PTE_SLEEP_PREP_US   1950000u  // KL15 off, own NM released, no foreign NM for 1.95 s: stop cyclics
 #define PTE_NM_CEILING_US   60000000u // NM (0x512/0x518) never later than 60 s after max(wake, last KL15-on 0x12F)
-#define PTE_512_RELEASE_US  45930000u // real DDE: last 0x512 at OFF+45.93 s
-#define PTE_518_RELEASE_US  29910000u // real EGS: last 0x518 at OFF+29.91 s
+// NM release timers (v1f). The real DDE/EGS keep their 645 ms NM grid running through
+// KL15 off and stop at a fixed time after OFF; the last frame is simply the last grid
+// slot before that time. Run 4: last 0x512 OFF+45.929 (next slot would be +46.57),
+// last 0x518 OFF+29.915 (ddecan) / +29.428 (noddecan; next slot +30.07). So the timers
+// are 46.0 s and 30.0 s (v1e stopped at "last real frame" = 45.93/29.91 and therefore
+// sent its last frame up to one period, ~0.25 s in run 6, earlier than the real ECU).
+#define PTE_512_RELEASE_US  46000000u // DDE: no 0x512 from OFF+46.0 s
+#define PTE_518_RELEASE_US  30000000u // EGS: no 0x518 from OFF+30.0 s
 #define PTE_518_NOKL15_US   30000000u // wake without KL15: 0x518 stops W+30 s (assumption, no capture)
 #define PTE_3FD_P_HOLD_US   30164000u // 0x3FD b2 0x20 -> 0x00 at OFF+30.164 s
+// v1f: a cyclic frame that is due but could not be sent on time is sent late (the grid
+// is kept, so the missed copies go out back to back with continuous alive counters),
+// unless it is more than 250 ms behind; then the grid restarts from now (counted in
+// 'resyncs'). A send more than PTE_LATE_US after its slot counts as a late send.
+#define PTE_CATCHUP_MAX_US  250000u
+#define PTE_LATE_US         5000u
 
 // ---- state --------------------------------------------------------------------
 typedef enum {
@@ -96,6 +108,10 @@ typedef struct {
     uint32_t n12f, kl15_on_edges, kl15_off_edges;
     pte_frame_t f[PTE_N_FRAMES];
     uint32_t tx_total, refused;
+    // v1f timing health
+    uint32_t late_sends;   // cyclic sends more than PTE_LATE_US after their slot
+    uint32_t late_max_us;  // worst lateness of a cyclic send
+    uint32_t resyncs;      // grid restarts (frames skipped because too far behind)
 } pte_t;
 
 typedef struct {
@@ -103,6 +119,8 @@ typedef struct {
     uint16_t id;
     uint8_t dlc;
     uint8_t data[8];
+    uint64_t due_us;       // the slot this frame was due in (lateness = send time - due_us)
+    bool cyclic_slot;      // true = a cyclic slot, false = an on-change (event) copy
 } pte_tx_t;
 
 // ---- API ----------------------------------------------------------------------
