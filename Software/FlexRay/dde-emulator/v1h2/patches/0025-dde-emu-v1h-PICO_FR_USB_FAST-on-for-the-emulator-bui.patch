+    uint32_t d = time_us_32() - t0;
+    if (d > 0xFFFFu) d = 0xFFFFu;
+    dg.last_hdr_us = (uint16_t)d;
+    if (d > dg.hdr_max) dg.hdr_max = (uint16_t)d;
+    if (d > 10u) sat16_inc(&dg.hdr_over10);
